services:
  socket-proxy:
    image: ghcr.io/tecnativa/docker-socket-proxy:{{ portainer_socket_proxy_version }}
    container_name: toolkit-socket-proxy
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - CONTAINERS=1
      - IMAGES=1
      - INFO=1
      - NETWORKS=1
      - SERVICES=1
      - TASKS=1
      - VOLUMES=1
      - VERSION=1
      - POST=0
      - BUILD=0
      - AUTH=0
      - SECRETS=0
      - SWARM=0
    networks:
      - socket_proxy_net

  portainer:
    image: portainer/portainer-ce:{{ portainer_version }}
    container_name: portainer
{% if raspberry_pi_network_toolkit_portainer_docker_access == 'proxy' %}
    # Read-only: the proxy refuses every POST/PUT/DELETE (POST=0). Portainer
    # ignores DOCKER_HOST; -H sets the URL of the local environment it creates
    # on first start.
    command: -H tcp://socket-proxy:2375
    depends_on:
      - socket-proxy
    volumes:
      - portainer_data:/data
{% else %}
    # Read-write socket: Portainer manages containers, so it needs the write
    # endpoints the read-only proxy refuses. This is root-equivalent access.
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy_network"
      - "traefik.http.routers.portainer.rule=Host(`{{ portainer_hostname }}`)"
      - "traefik.http.routers.portainer.entrypoints=websecure"
      - "traefik.http.routers.portainer.tls.certresolver=cloudflare"
      - "traefik.http.services.portainer.loadbalancer.server.port=9000"
    networks:
      - default
      - proxy_network
{% if raspberry_pi_network_toolkit_portainer_docker_access == 'proxy' %}
      - socket_proxy_net
{% endif %}
    restart: unless-stopped

  netdata:
    image: netdata/netdata:{{ netdata_version }}
    container_name: netdata
    depends_on:
      - socket-proxy
    cap_add:
      - SYS_PTRACE
    security_opt:
      - apparmor:unconfined
    environment:
      # Route Docker API access through the socket proxy instead of a direct socket mount.
      DOCKER_HOST: tcp://socket-proxy:2375
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - netdata_cache:/var/cache/netdata
      - netdata_lib:/var/lib/netdata
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy_network"
      - "traefik.http.routers.netdata.rule=Host(`{{ netdata_hostname }}`)"
      - "traefik.http.routers.netdata.entrypoints=websecure"
      - "traefik.http.routers.netdata.tls.certresolver=cloudflare"
      - "traefik.http.services.netdata.loadbalancer.server.port=19999"
    networks:
      - default
      - proxy_network
      - socket_proxy_net
    restart: unless-stopped

  uptime-kuma:
    image: louislam/uptime-kuma:{{ uptime_kuma_version }}
    container_name: uptime-kuma
    volumes:
      - uptime-kuma:/app/data
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy_network"
      - "traefik.http.routers.uptime-kuma.rule=Host(`{{ uptime_kuma_hostname }}`)"
      - "traefik.http.routers.uptime-kuma.entrypoints=websecure"
      - "traefik.http.routers.uptime-kuma.tls.certresolver=cloudflare"
      - "traefik.http.services.uptime-kuma.loadbalancer.server.port=3001"
    networks:
      - default
      - proxy_network
    restart: unless-stopped

volumes:
  portainer_data:
  netdata_cache:
  netdata_lib:
  uptime-kuma:

networks:
  default:
    driver: bridge
  proxy_network:
    external: true
    name: proxy_network
  socket_proxy_net:
    driver: bridge
    internal: true
